APP_NAME="MyDent"
APP_ENV=local
APP_KEY=base64:XsNfGQXAdV/89BfBk9ZYBARpEN6B1ZPP/pWVcaKr/94=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

MEDIA_DISK=public
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

