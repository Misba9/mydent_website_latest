{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "anandsiddharth/laravel-paytm-wallet": "^2.0",
        "authorizenet/authorizenet": "^2.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "firebase/php-jwt": "^6.10",
        "gerardojbaez/money": "^0.3.1",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.4",
        "lab404/laravel-impersonate": "^1.7.4",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^10.50.4",
        "laravel/tinker": "^2.8",
        "laravelcollective/html": "^6.4",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^2.12.7",
        "maatwebsite/excel": "^3.1",
        "macsidigital/laravel-zoom": "^8.0",
        "mariuzzo/laravel-js-localization": "^1.10",
        "mews/purifier": "^3.4",
        "opcodesio/log-viewer": "^1.9",
        "rap2hpoutre/laravel-log-viewer": "^2.3",
        "rappasoft/laravel-livewire-tables": "^2.15",
        "razorpay/razorpay": "^2.9",
        "spatie/laravel-google-calendar": "^3.5",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^5.8",
        "srmklive/paypal": "^3.0",
        "stripe/stripe-php": "^7.98",
        "tightenco/ziggy": "^1.1",
        "unicodeveloper/laravel-paystack": "^1.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.8",
        "barryvdh/laravel-ide-helper": "^2.13",
        "beyondcode/laravel-query-detector": "^1.7",
        "fakerphp/faker": "^1.9.1",
        "laravel/breeze": "^1.18",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.3",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "ignore": [
                "PKSA-mdq4-51ck-6kdq",
                "PKSA-y2cr-5h3j-g3ys",
                "PKSA-pg71-gz29-h5sq"
            ]
        },
        "policy": {
            "advisories": {
                "ignore-id": ["PKSA-mdq4-51ck-6kdq", "PKSA-y2cr-5h3j-g3ys", "PKSA-pg71-gz29-h5sq", "PKSA-yxbx-3c9s-cjt9", "PKSA-d5tc-s1qs-h781", "PKSA-m5cs-t1y6-qpcs", "PKSA-3r5d-mb8f-1qw9"]
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
